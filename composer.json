{
    "name": "dhsa/chronos",
    "description": "Real-time Queue Dashboard & Manager for Hyperf (Redis Async Queue)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DHSA Team"
        }
    ],
    "require": {
        "php": ">=8.1",
        "hyperf/async-queue": "~3.0.0 || ~3.1.0",
        "hyperf/redis": "~3.0.0 || ~3.1.0",
        "hyperf/http-server": "~3.0.0 || ~3.1.0"
    },
    "autoload": {
        "psr-4": {
            "Chronos\\": "src/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Chronos\\ConfigProvider"
        }
    }
}
